# Copy this file to .env and fill in your values. The CLI loads .env automatically
# (see webagent/config.py); real exported env vars always take precedence over it.

# --- Model provider API keys ---------------------------------------------------
# Required for the provider(s) you use. The model id's prefix picks the provider,
# e.g. `anthropic:claude-sonnet-5` needs ANTHROPIC_API_KEY, `openai:gpt-5.6-terra`
# needs OPENAI_API_KEY.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Traces --------------------------------------------------------------------
# Top-level directory run traces are written under. `webagent run` writes to
# $TRACES_DIR/live and the eval harness writes to $TRACES_DIR/evals; `webagent
# trace list|show|serve` browse the whole tree. Default: traces
TRACES_DIR=traces

# --- Full model-input capture (debugging) --------------------------------------
# Set to 1 to write every model request verbatim to
# $TRACES_DIR/requests/<trace_id>.requests.txt: the system prompt, the whole message
# history (with observations stubbed exactly as the model saw them), and the tool
# definitions.
# Off by default: the capture runs several times the size of the trace itself.
# TRACE_FULL_INPUT=1

# --- Logging -------------------------------------------------------------------
# Default logging verbosity when --log-level isn't passed. One of
# DEBUG | INFO | WARNING | ERROR. Default: WARNING
LOG_LEVEL=WARNING
